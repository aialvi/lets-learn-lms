PORT=3001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-in-production

# OpenRouter powers the protected /ai/study-coach endpoint.
# Get a key from https://openrouter.ai/keys and keep the real value out of git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Worker runs every minute; disable in tests or on non-worker replicas.
TRAINING_WORKER_ENABLED=true
# Enable only after SMTP is configured. Disabled messages are never backfilled.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
